						"exec": [
							"\r",
							"pm.test(\"API-LOCAL-005: Product not found returns 404\", function () {\r",
							"\r",
							"    pm.response.to.have.status(404);\r",
							"\r",
							"    const data = pm.response.json();\r",
							"\r",
							"    pm.expect(data.message).to.eql(\"Product not found\");\r",
							"\r",
							"});\r",
							""
