		{
			"name": "GET All Products – 200",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"\r",
							"pm.test(\"API-LOCAL-001: Status is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"API-LOCAL-002: Returns exactly 3 products\", function () {\r",
							"    const products = pm.response.json();\r",
							"\r",
							"    pm.expect(products).to.be.an(\"array\");\r",
							"    pm.expect(products).to.have.lengthOf(3);\r",
							"});\r",
							"\r",
							"pm.test(\"API-LOCAL-003: Headphones price is correct\", function () {\r",
							"    const products = pm.response.json();\r",
							"\r",
							"    const headphones = products.find(\r",
							"        product => product.id === 1\r",
							"    );\r",
							"\r",
							"    pm.expect(headphones).to.exist;\r",
							"    pm.expect(headphones.price).to.eql(49.99);\r",
							"});\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
